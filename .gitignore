bin/
dist/

# Local panecom pane/session state, not part of the project.
.panecom/

# The operator's own configuration holds an offline token. Only the
# example is tracked.
#
# Anchored to the repository root on purpose. Without the leading slash
# these patterns match at every depth, which would also hide
# deploy/base/config.yaml — a scope-only file that has to be tracked for
# `kubectl kustomize` to resolve its configMapGenerator.
/config.yaml
/config.local.yaml
*.local.yaml
.env

# A credential kept on disk for local --check-auth runs. Never commit it,
# and prefer chmod 600: anything here is a live Red Hat offline token.
token
token.*
*.token

# A kubeconfig in the repository root holds cluster credentials. Root
# anchored, like the config.yaml patterns above: a .kube somewhere else
# in the tree is not this file. Also in .dockerignore, because the build
# stage copies the whole context.
/.kube/

# Kubernetes Secrets. Only deploy/base/secret.example.yaml is tracked —
# it is a template with REPLACE_ME placeholders. A filled-in copy holds
# both the Red Hat offline token and the shared HTTP token, and the two
# are a file rename away from each other, so the real ones are excluded
# by name rather than by discipline.
deploy/**/secret.yaml
deploy/**/secret-*.yaml
deploy/**/*.local.yaml
secret.yaml
!deploy/base/secret.example.yaml
