bin/
dist/

# Local panecom pane/session state, not part of the project.
.panecom/

# Real configuration holds an offline token. Only the example is tracked.
config.yaml
config.local.yaml
*.local.yaml
.env

# A credential kept on disk for local --check-auth runs. Never commit it,
# and prefer chmod 600: anything here is a live Red Hat offline token.
token
token.*
*.token
